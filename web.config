<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- FastCGI application entry for PHP. The handler below references this same executable path. -->
    <fastCgi>
      <application fullPath="C:\Program Files\php-8.4.3-nts-Win32-vs17-x64\php-cgi.exe" />
    </fastCgi>
    <!-- FastCGI handler for PHP. Replace the scriptProcessor path with your php-cgi.exe full path -->
    <handlers>
      <add name="PHP_via_FastCGI" path="*.php" verb="*" modules="FastCgiModule"
        scriptProcessor="C:\Program Files\php-8.4.3-nts-Win32-vs17-x64\php-cgi.exe"
        resourceType="Either" requireAccess="Script" />
    </handlers>
    <!-- Ensure .php is not blocked by request filtering -->
    <security>
      <requestFiltering>
        <fileExtensions>
          <remove fileExtension=".php" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
